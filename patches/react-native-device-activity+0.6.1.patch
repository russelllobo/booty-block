@@ -5,8 +5,59 @@ import FamilyControls
 import Foundation
 import ManagedSettings
 import ManagedSettingsUI
+import SwiftUI
 import os
 
+@available(iOS 16.0, *)
+@MainActor
+func renderApplicationIconDataUri(applicationToken: ApplicationToken) -> String? {
+  let renderer = ImageRenderer(
+    content: Label(applicationToken)
+      .labelStyle(.iconOnly)
+      .font(.system(size: 80))
+      .imageScale(.large)
+      .frame(width: 96, height: 96)
+  )
+  renderer.scale = UIScreen.main.scale
+
+  guard let image = renderer.uiImage,
+    let pngData = image.pngData()
+  else {
+    return nil
+  }
+
+  return "data:image/png;base64,\(pngData.base64EncodedString())"
+}
+
+@available(iOS 15.0, *)
+func applicationMetadataPayload(selection: FamilyActivitySelection) -> [[String: String]] {
+  selection.applicationTokens.map { applicationToken in
+    var payload: [String: String] = [
+      "id": "\(applicationToken.hashValue)"
+    ]
+
+    if let displayName = Application(token: applicationToken).localizedDisplayName {
+      payload["displayName"] = displayName
+    }
+
+    if #available(iOS 16.0, *) {
+      if Thread.isMainThread {
+        MainActor.assumeIsolated {
+          payload["iconDataUri"] = renderApplicationIconDataUri(applicationToken: applicationToken)
+        }
+      } else {
+        DispatchQueue.main.sync {
+          MainActor.assumeIsolated {
+            payload["iconDataUri"] = renderApplicationIconDataUri(applicationToken: applicationToken)
+          }
+        }
+      }
+    }
+
+    return payload
+  }
+}
