{
  "expo": {
    "name": "Bootyblock",
    "slug": "bootyblock",
    "scheme": [
      "bootyblock",
      "device-activity"
    ],
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bootyblock.app",
      "appleTeamId": "SZ78KGUF6B",
      "infoPlist": {
        "NSCameraUsageDescription": "Bootyblock uses your camera on-device to count squats. Video is not recorded or uploaded.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.bootyblock.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF1F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-asset",
        {
          "assets": [
            "assets/onboarding/squatting-cut.gif",
            "assets/onboarding/squatting-poster.jpg",
            "assets/onboarding/slide-two.jpg",
            "assets/onboarding/position-phone-floor.gif",
            "assets/onboarding/position-step-back-squat.gif"
          ]
        }
      ],
      "./plugins/with-local-notifications-only",
      [
        "expo-camera",
        {
          "cameraPermission": "Bootyblock uses your camera on-device to count squats. Video is not recorded or uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/with-production-info-plist-cleanup",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "SZ78KGUF6B",
          "appGroup": "group.com.bootyblock.app",
          "copyToTargetFolder": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "posthog-react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.bootyblock.app.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.bootyblock.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.bootyblock.app.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.bootyblock.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.bootyblock.app.ActivityMonitorExtension",
                  "targetName": "ActivityMonitorExtension",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.bootyblock.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "80362fc1-47ce-4139-8e2c-fd49f8b5ca49"
      }
    },
    "owner": "russelllobo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/80362fc1-47ce-4139-8e2c-fd49f8b5ca49"
    }
  }
}
